// Worker minimal : déclencheur cron de l'import de L'Agenda Militant
// Indépendant. HORAIRE depuis le 2026-06-14 (demande Ben : actualiser les
// mobilisations régulièrement) ; à la 42e minute pour éviter la congestion
// avec les autres crons (brèves :12, médias :32, demosphère :52). Appelle
// l'endpoint protégé du site avec le secret CRON_SECRET (posé via
// `wrangler secret put CRON_SECRET --config infra/cron-agenda/wrangler.jsonc`).
{
  "name": "maintenant-cron-agenda",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "triggers": {
    "crons": ["42 * * * *"]
  }
}
